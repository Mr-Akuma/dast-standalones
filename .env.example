# Copy to .env on the EC2 host and replace every value.

POSTGRES_DB=dast
POSTGRES_USER=dast
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

REVELIO_SECRET=replace-with-a-64-plus-character-random-secret
DAST_ADMIN_USER=secops
# Generate with:
# python -c "from werkzeug.security import generate_password_hash; import getpass; print(generate_password_hash(getpass.getpass('Dashboard password: ')))"
DAST_ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash

DAST_ALLOW_DEFAULT_LOGIN=0
DAST_CSRF_PROTECT=1
DAST_COOKIE_SAMESITE=Strict
# Use 1 when the dashboard is served through HTTPS/ALB/Nginx.
DAST_COOKIE_SECURE=0
DAST_SESSION_HOURS=8
DAST_LOGIN_MAX_ATTEMPTS=5
DAST_LOGIN_WINDOW_SECONDS=900

DAST_PORT=5000
